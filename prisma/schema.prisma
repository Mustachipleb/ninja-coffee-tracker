// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A member of the friend group who brews coffee and owes/pays for beans.
model User {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  brews     Brew[]
  favorites FavoriteSetting[]
}

/// A bag of beans that was loaded into the Ninja Luxe Premier, with the
/// info needed to work out a per-gram cost.
model Bean {
  id          String   @id @default(cuid())
  name        String
  roaster     String?
  weightGrams Float
  priceCents  Int
  createdAt   DateTime @default(now())

  brews       Brew[]
}

/// The brewing style presets available on the Ninja Luxe Premier.
enum BrewStyle {
  CLASSIC
  RICH
  OVER_ICE
  SPECIALTY
  COLD_BREW
}

/// A single logged cup of coffee brewed by a user, with the exact machine
/// settings used, so cost and habits can be tracked over time.
model Brew {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  bean            Bean      @relation(fields: [beanId], references: [id], onDelete: Restrict)
  beanId          String
  grindAmountGrams Float
  milkFrothed     Boolean   @default(false)
  brewStyle       BrewStyle @default(CLASSIC)
  label           String?
  brewedAt        DateTime  @default(now())

  @@index([userId])
  @@index([beanId])
}

/// A saved combination of brew settings a user likes, so it can be
/// re-applied quickly next time instead of re-entering everything.
model FavoriteSetting {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  label           String
  grindAmountGrams Float
  milkFrothed     Boolean   @default(false)
  brewStyle       BrewStyle @default(CLASSIC)
  createdAt       DateTime  @default(now())

  @@unique([userId, label])
}
