// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A member of the friend group who brews coffee and owes/pays for beans.
model User {
  id        String   @id @default(cuid())
  name      String   @unique
  password  String?
  createdAt DateTime @default(now())

  brews     Brew[]
  favorites FavoriteSetting[]
  payments  Payment[]
  sessions  Session[]
}

/// Server session for authenticated users.
model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime

  @@index([userId])
}

/// A bag of beans that was loaded into the Ninja Luxe Premier, with the
/// info needed to work out a per-gram cost.
model Bean {
  id          String   @id @default(cuid())
  name        String
  roaster     String?
  weightGrams Float
  priceCents  Int
  createdAt   DateTime @default(now())

  brews       Brew[]
}

/// The basket sizes available on the Ninja Luxe Premier, each with its own
/// approximate grind (coffee grounds) weight.
enum BasketSize {
  SINGLE
  DOUBLE
  LUXE
}

/// A type of milk that can be frothed into a brew, with its own price per
/// liter so milk cost can be added on top of the bean cost.
model MilkType {
  id                 String   @id @default(cuid())
  name               String   @unique
  pricePerLiterCents Int
  createdAt          DateTime @default(now())

  brews     Brew[]
  favorites FavoriteSetting[]
}

/// The brewing style presets available on the Ninja Luxe Premier.
enum BrewStyle {
  CLASSIC
  RICH
  OVER_ICE
  SPECIALTY
  COLD_BREW
}

/// A single logged cup of coffee brewed by a user, with the exact machine
/// settings used, so cost and habits can be tracked over time.
model Brew {
  id            String     @id @default(cuid())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  bean          Bean       @relation(fields: [beanId], references: [id], onDelete: Restrict)
  beanId        String
  basketSize    BasketSize @default(DOUBLE)
  milkType      MilkType?  @relation(fields: [milkTypeId], references: [id], onDelete: Restrict)
  milkTypeId    String?
  milkVolumeMl  Float?
  label         String?
  brewedAt      DateTime   @default(now())

  @@index([userId])
  @@index([beanId])
  @@index([milkTypeId])
}

/// A saved combination of brew settings a user likes, so it can be
/// re-applied quickly next time instead of re-entering everything.
model FavoriteSetting {
  id            String     @id @default(cuid())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  label         String
  basketSize    BasketSize @default(DOUBLE)
  milkType      MilkType?  @relation(fields: [milkTypeId], references: [id], onDelete: Restrict)
  milkTypeId    String?
  milkVolumeMl  Float?
  createdAt     DateTime   @default(now())

  @@unique([userId, label])
  @@index([milkTypeId])
}

/// Single global settings row for app-wide payment recipient configuration.
model AppSettings {
  id                String   @id
  paymentRecipient  String
  paymentIban       String
  paymentBic        String?
  paymentReference  String
  updatedAt         DateTime @updatedAt
}

/// A payment made by a user toward their coffee tab.
model Payment {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId])
}
